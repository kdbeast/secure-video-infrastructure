{
  "name": "@siv/playback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@siv/contracts": "workspace:*",
    "@siv/shared": "workspace:*",
    "@siv/storage": "workspace:*",
    "@siv/videos": "workspace:*"
  },
  "devDependencies": {
    "@siv/typescript": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
