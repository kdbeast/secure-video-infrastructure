# apps/web environment.
# Copy to apps/web/.env.local for local development. .env.local is git-ignored; never commit it.
# Production values come from the deployment platform, never from a committed file.
#
# NEVER put secrets in the web app: no database, Redis, R2, JWT or AI credentials.
# No NEXT_PUBLIC_ variables are approved. Next.js embeds NEXT_PUBLIC_ values in browser
# JavaScript, so adding one requires review.

# Server-only. Base URL of the Express API for server-side requests. Not public.
# Optional in development (default: http://localhost:4000); required in production.
API_INTERNAL_URL=http://localhost:4000
