{
  "name": "@siv/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --import tsx --watch main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint ."
  },
  "dependencies": {
    "@siv/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@siv/eslint-config": "workspace:*",
    "@siv/typescript": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
