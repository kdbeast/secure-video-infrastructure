# apps/api environment.
# Copy to apps/api/.env for local development. apps/api/.env is git-ignored; never commit it.
# Production values come from the deployment platform, never from a committed file.
# Variables already set in the shell or platform take precedence over this file.

# Runtime mode: development | production | test. Optional (default: development).
NODE_ENV=development

# HTTP port the API listens on. Optional (default: 4000).
PORT=4000

# Log level: fatal | error | warn | info | debug | trace | silent. Optional (default: info).
LOG_LEVEL=info
